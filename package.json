{
    "name": "rpkg",
    "version": "0.0.0",
    "private": true,
    "description": "Open roleplay package format",
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun run --filter '*' build",
        "check": "tsc -p packages/core/tsconfig.json && tsc -p packages/cli/tsconfig.json",
        "fmt": "oxfmt package.json packages oxfmt.config.ts oxlint.config.ts",
        "lint": "oxlint packages",
        "lint:fix": "oxlint --fix --fix-suggestions packages"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "typescript": "^7.0.0"
    }
}
